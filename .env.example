# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/linkmount

# Secret key for JWT signing and verification (minimum 32 characters recommended)
JWT_SECRET=supersecretjwtkeyforlinkmountappmustbeatleast32chars

# Initial Administrator credentials for seeding (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminStrongPassword123!

# Base URL used to build public tenant links and QR code contents
NEXT_PUBLIC_BASE_URL=http://localhost:3000
